{
  "name": "initial-editor-main",
  "version": "2.0.0-dev",
  "repository": "https://github.com/biud436/InitialEditor.git",
  "author": "biud436 <biud436@gmail.com>",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "yarn@4.3.1",
  "scripts": {
    "dev": "yarn workspace @initial-editor/app dev",
    "build": "yarn workspace @initial-editor/app build",
    "build:desktop": "yarn workspace @initial-editor/app build:desktop",
    "preview": "yarn workspace @initial-editor/app preview",
    "typecheck": "tsc -b packages/core packages/backend-bridge packages/backend-tauri packages/backend-fsaccess packages/ext-tilemap packages/ext-rpg packages/ext-rpg/test packages/app tests",
    "lint": "eslint packages tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:conformance": "yarn workspace @initial-editor/backend-bridge test:conformance",
    "test:rust": "cd src-tauri && cargo test",
    "test:e2e": "playwright test",
    "test:engine": "node scripts/e2e-engine-hotreload.mjs",
    "test:engine-scene": "node scripts/e2e-engine-scene.mjs",
    "test:android-stage": "node scripts/e2e-android-stage.mjs",
    "test:engine-events": "yarn workspace @initial-editor/ext-rpg test:engine-events",
    "sync:templates": "node scripts/sync-engine-templates.mjs",
    "sync:rpg": "node scripts/sync-engine-rpg.mjs",
    "sync:engine-web": "node scripts/sync-engine-web.mjs",
    "engine:fetch": "node scripts/fetch-engine.mjs",
    "engine:check": "node scripts/check-engine-pin.mjs",
    "version:set": "node scripts/version.mjs set",
    "version:check": "node scripts/version.mjs check",
    "licenses": "node scripts/gen-licenses.mjs",
    "selftest:app": "node scripts/selftest-app.mjs",
    "check:colors": "node scripts/check-color-literals.mjs",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.48.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0"
  }
}
