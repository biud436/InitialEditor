{
  "version": 1,
  "uses": ["scripts/components/flappy/common.nodes.json"],
  "state": {
    "from": "flappy.state",
    "fields": []
  },
  "locals": [
    { "key": "dt", "type": "number", "label": "틱 시간 (초)" }
  ],
  "nodes": [
    { "id": "st_state", "kind": "state.get", "field": "state" },
    { "id": "st_h", "kind": "state.get", "field": "H" },
    { "id": "st_ground", "kind": "state.get", "field": "GROUND_Y" },
    { "id": "st_ready", "kind": "state.get", "field": "readyTime" },
    { "id": "st_vy", "kind": "state.get", "field": "birdVy" },
    { "id": "st_angle", "kind": "state.get", "field": "birdAngle" },
    { "id": "st_auto", "kind": "state.get", "field": "autoplay" },
    { "id": "self", "kind": "obj.self" },
    { "id": "oy", "kind": "obj.get", "field": "y" },
    { "id": "c_gravity", "kind": "lib.const", "const": "flappy.GRAVITY" },
    { "id": "c_flap", "kind": "lib.const", "const": "flappy.FLAP" },
    { "id": "c_maxfall", "kind": "lib.const", "const": "flappy.MAX_FALL" },
    { "id": "c_birdx", "kind": "lib.const", "const": "flappy.BIRD_X" },
    { "id": "c_birdh", "kind": "lib.const", "const": "flappy.BIRD_H" },
    { "id": "dt", "kind": "local.get", "field": "dt" },
    { "id": "half_h", "kind": "math.div", "in": { "a": "st_h" }, "args": { "b": 2 } },
    { "id": "half_bird", "kind": "math.div", "in": { "a": "c_birdh" }, "args": { "b": 2 } },
    { "id": "center", "kind": "math.sub", "in": { "a": "half_h", "b": "half_bird" } },
    { "id": "init", "kind": "event.init", "next": "keep_bird" },
    { "id": "keep_bird", "kind": "state.set", "field": "bird", "in": { "value": "self" }, "next": "place_x" },
    { "id": "place_x", "kind": "obj.set", "field": "x", "in": { "value": "c_birdx" }, "next": "place_y" },
    { "id": "place_y", "kind": "obj.set", "field": "y", "in": { "value": "center" } },
    { "id": "update", "kind": "event.update", "next": "set_dt" },
    { "id": "tick_dt", "kind": "lib.call", "fn": "flappy.dt", "in": { "elapsed": "update.elapsed" } },
    { "id": "set_dt", "kind": "local.set", "field": "dt", "in": { "value": "tick_dt" }, "next": "by_state" },
    { "id": "by_state", "kind": "flow.switch", "in": { "value": "st_state" }, "next": "sync_angle", "cases": { "ready": "float_y", "play": "fall", "dead": "tumble_if" } },
    { "id": "ready_phase", "kind": "math.mul", "in": { "a": "st_ready" }, "args": { "b": 4 } },
    { "id": "ready_sin", "kind": "math.sin", "in": { "a": "ready_phase" } },
    { "id": "float_off", "kind": "math.mul", "in": { "a": "ready_sin" }, "args": { "b": 14 } },
    { "id": "float_pos", "kind": "math.add", "in": { "a": "center", "b": "float_off" } },
    { "id": "float_y", "kind": "obj.set", "field": "y", "in": { "value": "float_pos" }, "next": "float_angle" },
    { "id": "float_tilt", "kind": "math.mul", "in": { "a": "ready_sin" }, "args": { "b": 6 } },
    { "id": "float_angle", "kind": "state.set", "field": "birdAngle", "in": { "value": "float_tilt" } },
    { "id": "gravity_dt", "kind": "math.mul", "in": { "a": "c_gravity", "b": "dt" } },
    { "id": "vy_gravity", "kind": "math.add", "in": { "a": "st_vy", "b": "gravity_dt" } },
    { "id": "fall", "kind": "state.set", "field": "birdVy", "in": { "value": "vy_gravity" }, "next": "cap_if" },
    { "id": "too_fast", "kind": "cmp.gt", "in": { "a": "st_vy", "b": "c_maxfall" } },
    { "id": "cap_if", "kind": "flow.branch", "in": { "cond": "too_fast" }, "next": "move", "then": "cap" },
    { "id": "cap", "kind": "state.set", "field": "birdVy", "in": { "value": "c_maxfall" } },
    { "id": "vy_dt", "kind": "math.mul", "in": { "a": "st_vy", "b": "dt" } },
    { "id": "moved_y", "kind": "math.add", "in": { "a": "oy", "b": "vy_dt" } },
    { "id": "move", "kind": "obj.set", "field": "y", "in": { "value": "moved_y" }, "next": "ceil_if" },
    { "id": "above_top", "kind": "cmp.lt", "in": { "a": "oy" }, "args": { "b": 0 } },
    { "id": "ceil_if", "kind": "flow.branch", "in": { "cond": "above_top" }, "next": "flap_if", "then": "ceil_y" },
    { "id": "ceil_y", "kind": "obj.set", "field": "y", "args": { "value": 0 }, "next": "ceil_vy" },
    { "id": "ceil_vy", "kind": "state.set", "field": "birdVy", "args": { "value": 0 } },
    { "id": "flap_input", "kind": "lib.call", "fn": "flappy.flapPressed" },
    { "id": "flap_if", "kind": "flow.branch", "in": { "cond": "flap_input" }, "next": "auto_if", "then": "flap" },
    { "id": "flap", "kind": "state.set", "field": "birdVy", "in": { "value": "c_flap" }, "next": "flap_sound" },
    { "id": "flap_sound", "kind": "lib.call", "fn": "flappy.sfx", "args": { "name": "flap" } },
    { "id": "falling", "kind": "cmp.gt", "in": { "a": "st_vy" }, "args": { "b": 0 } },
    { "id": "half_screen", "kind": "math.mul", "in": { "a": "st_h" }, "args": { "b": 0.5 } },
    { "id": "below_half", "kind": "cmp.gt", "in": { "a": "oy", "b": "half_screen" } },
    { "id": "low_fall", "kind": "logic.and", "in": { "a": "falling", "b": "below_half" } },
    { "id": "auto_flap", "kind": "logic.and", "in": { "a": "st_auto", "b": "low_fall" } },
    { "id": "auto_if", "kind": "flow.branch", "in": { "cond": "auto_flap" }, "next": "tilt", "then": "auto" },
    { "id": "auto", "kind": "state.set", "field": "birdVy", "in": { "value": "c_flap" } },
    { "id": "tilt_raw", "kind": "math.mul", "in": { "a": "st_vy" }, "args": { "b": 0.075 } },
    { "id": "tilt_clamped", "kind": "math.clamp", "in": { "value": "tilt_raw" }, "args": { "min": -22, "max": 60 } },
    { "id": "tilt", "kind": "state.set", "field": "birdAngle", "in": { "value": "tilt_clamped" }, "next": "ground_if" },
    { "id": "bird_bottom", "kind": "math.add", "in": { "a": "oy", "b": "c_birdh" } },
    { "id": "on_ground", "kind": "cmp.ge", "in": { "a": "bird_bottom", "b": "st_ground" } },
    { "id": "ground_y", "kind": "math.sub", "in": { "a": "st_ground", "b": "c_birdh" } },
    { "id": "ground_if", "kind": "flow.branch", "in": { "cond": "on_ground" }, "then": "land" },
    { "id": "land", "kind": "obj.set", "field": "y", "in": { "value": "ground_y" }, "next": "die" },
    { "id": "die", "kind": "lib.call", "fn": "flappy.die" },
    { "id": "in_air", "kind": "cmp.lt", "in": { "a": "bird_bottom", "b": "st_ground" } },
    { "id": "tumble_if", "kind": "flow.branch", "in": { "cond": "in_air" }, "then": "drop" },
    { "id": "drop", "kind": "state.set", "field": "birdVy", "in": { "value": "vy_gravity" }, "next": "drop_move" },
    { "id": "drop_move", "kind": "obj.set", "field": "y", "in": { "value": "moved_y" }, "next": "spin" },
    { "id": "spin_dt", "kind": "math.mul", "in": { "b": "dt" }, "args": { "a": 220 } },
    { "id": "spin_add", "kind": "math.add", "in": { "a": "st_angle", "b": "spin_dt" } },
    { "id": "spin_max", "kind": "math.min", "in": { "b": "spin_add" }, "args": { "a": 90 } },
    { "id": "spin", "kind": "state.set", "field": "birdAngle", "in": { "value": "spin_max" }, "next": "sink_if" },
    { "id": "sunk", "kind": "cmp.gt", "in": { "a": "bird_bottom", "b": "st_ground" } },
    { "id": "sink_if", "kind": "flow.branch", "in": { "cond": "sunk" }, "then": "sink" },
    { "id": "sink", "kind": "obj.set", "field": "y", "in": { "value": "ground_y" } },
    { "id": "sync_angle", "kind": "prop.set", "field": "angle", "type": "number", "in": { "value": "st_angle" }, "next": "sync_anim" },
    { "id": "alive", "kind": "cmp.ne", "in": { "a": "st_state" }, "args": { "b": "dead" } },
    { "id": "sync_anim", "kind": "obj.set", "field": "animate", "in": { "value": "alive" } }
  ],
