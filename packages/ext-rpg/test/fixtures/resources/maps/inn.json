          "thenDo": [
            {
              "code": "message",
              "text": "방은 그대로 두었어요. 저녁 배를 타시더라도 짐은 챙겨 가세요.",
              "name": "여관 주인",
              "face": {
                "set": "npc",
                "index": 9
              }
            },
            {
              "code": "if",
              "cond": {
                "flag": "heardWarehouse"
              },
              "thenDo": [
                {
                  "code": "if",
                  "cond": {
                    "flag": "gaveKey"
                  },
                  "elseDo": [
                    {
                      "code": "setFlag",
                      "key": "gaveKey"
                    },
                    {
                      "code": "message",
                      "text": "창고 얘기를 들으셨군요. 그 열쇠라면 여기 있어요. 주인이 떠나면서 맡기고 갔거든요.",
                      "name": "여관 주인",
                      "face": {
                        "set": "npc",
                        "index": 1
                      }
                    },
                    {
                      "code": "giveItem",
                      "item": "warehouse_key"
                    },
                    {
                      "code": "playSe",
                      "file": "./resources/audio/ui_decision.wav",
                      "id": "item"
                    },
                    {
                      "code": "message",
                      "text": "창고 열쇠를 받았다."
                    },
                    {
                      "code": "message",
                      "text": "등유가 남아 있을 거예요. 등대 노인께 가져다 드리세요. 주인도 그걸 아까워할 사람은 아니었어요.",
                      "name": "여관 주인",
                      "face": {
                        "set": "npc",
                        "index": 1
                      }
                    }
                  ]
                }
              ]
            }
          ],
          "elseDo": [
