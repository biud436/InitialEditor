# 텍스처 1장을 그리는 스프라이트 (시트 애니메이션, 회전, 확대, 불투명도)
class Sprite
  # 스프라이트 생성. 텍스처는 TextureManager 에 먼저 등록 필요 (Lua 는 인자가 부족하면 0 반환)
  def initialize: (Numeric x, Numeric y, Integer width, Integer height, Integer max_frames, String texture_id) -> void

  # 이미지 파일을 텍스처로 로드해 스프라이트 생성 (Lua 의 scripts/lua/image.lua 에 해당). 실패 시 RuntimeError
  def self.load: (String path, String id, ?Numeric x, ?Numeric y, ?Integer width, ?Integer height, ?Integer frames) -> Sprite

  # 경과 시간만큼 애니메이션 진행 후 변환(위치, 확대, 회전) 적용
  def update: (Numeric elapsed) -> Sprite

  # 화면에 그리기
  def draw: () -> Sprite

  # 위치 (x, y)
  def position: () -> Array[Numeric]

  # x 좌표
  def x: () -> Numeric

  # y 좌표
  def y: () -> Numeric

  # 위치 설정
  def set_position: (Numeric x, Numeric y) -> Sprite

  # x 좌표만 설정
  def x=: (Numeric x) -> void

  # y 좌표만 설정
  def y=: (Numeric y) -> void

  # [x, y] 로 위치 설정
  def position=: (Array[Numeric] pair) -> void

  # 확대 배율
  def scale: () -> Numeric

  # 확대 배율 설정
  def scale=: (Numeric scale) -> void

  # 한 프레임 너비 (px)
  def width: () -> Integer

  # 한 프레임 높이 (px)
  def height: () -> Integer

  # 회전 각도(도)
  def angle: () -> Numeric

  # 회전 각도(도) 설정
  def angle=: (Numeric degrees) -> void

  # 회전 각도(라디안)
  def radians: () -> Numeric

  # 회전 각도(라디안) 설정
  def radians=: (Numeric radians) -> void

  # 보이는 상태면 true
  def visible?: () -> bool

  # 표시 여부 설정
  def visible=: (bool visible) -> void

  # 불투명도 (0..255)
  def opacity: () -> Integer

  # 불투명도 설정
  def opacity=: (Integer opacity) -> void

  # 프레임 사이 시간(ms)
  def frame_delay: () -> Numeric

  # 프레임 사이 시간 설정
  def frame_delay=: (Numeric delay) -> void

  # 애니메이션 프레임 범위 설정 (last 는 마지막 프레임의 다음 번호)
  def set_frames: (Integer first, Integer last) -> Sprite

  # 애니메이션 첫 프레임
  def start_frame: () -> Integer

  # 애니메이션 마지막 프레임
  def end_frame: () -> Integer

  # 현재 프레임
  def current_frame: () -> Integer

  # 현재 프레임 설정
  def current_frame=: (Integer frame) -> void

  # 애니메이션 반복 여부 설정
  def loop=: (bool loop) -> void

  # 애니메이션이 끝났으면 true
  def anim_complete?: () -> bool

  # 애니메이션 완료 상태 설정
  def anim_complete=: (bool complete) -> void

  # 시트 분할 설정 (열 수 cols, 행 수 rows, 기본 4x4, R2K3 CharSet 은 3x4)
  def set_sheet_grid: (Integer cols, Integer rows) -> Sprite

  # 소스 사각형 (텍스처에서 잘라 그리는 영역). Lua 는 width, height 키에 오른쪽, 아래 좌표가 들어 있음. Ruby 는 x, y, right, bottom, width, height 키
  def rect: () -> Hash[untyped, untyped]

  # 소스 사각형 설정 (텍스처에서 잘라 그릴 영역, x, y, width, height 키를 가진 테이블 1개도 허용)
  def set_rect: (Integer x, Integer y, Integer width, Integer height) -> Sprite | (Hash[untyped, untyped] rect) -> Sprite

  # 스프라이트 해제 (텍스처는 해제하지 않음)
  def dispose: () -> void

  # 이미 해제했으면 true (해제 후 사용하면 RuntimeError)
  def disposed?: () -> bool
end

# 맵 포맷 v1, v2 JSON 을 로드해 그리는 다층 타일맵 (x, y 는 0부터 세는 타일 좌표)
class Tilemap
  # 맵 파일 로드. 실패 시 nil (Lua 는 오류 메시지도 반환)
  def self.load: (String path) -> Tilemap?

  # 맵 파일 로드. 실패 시 RuntimeError (메시지는 로더의 오류)
  def initialize: (String path) -> void

  # 레이어 범위를 카메라 오프셋을 적용해 그리기 (화면에 보이는 타일만)
  def draw: (Integer layer_from, Integer layer_to, ?Integer cam_x, ?Integer cam_y) -> Tilemap

  # 맵 크기 (너비 타일 수, 높이 타일 수, 타일 너비 px, 타일 높이 px, 레이어 수)
  def size: () -> Array[Integer]

  # 맵 너비 (타일 수)
  def width: () -> Integer

  # 맵 높이 (타일 수)
  def height: () -> Integer

  # 타일 너비 (px)
  def tile_width: () -> Integer

  # 타일 높이 (px)
  def tile_height: () -> Integer

  # 레이어 수
  def layer_count: () -> Integer

  # 타일 gid (빈 타일과 범위 밖은 0)
  def tile_id: (Integer x, Integer y, Integer layer) -> Integer

  # 타일 gid 변경. 변경하면 true, 범위 밖이면 false
  def set_tile_id: (Integer x, Integer y, Integer layer, Integer gid) -> bool

  # 타일 좌표 (x, y)가 통행 가능하면 true (범위 밖은 false)
  def passable?: (Integer x, Integer y) -> bool

  # 타일맵 해제 (타일셋 텍스처는 TextureManager 에 남음)
  def dispose: () -> void

  # 이미 해제했으면 true (해제 후 사용하면 RuntimeError)
  def disposed?: () -> bool
end

# 시스템 폰트로 텍스트 텍스처를 만드는 동적 폰트 (Windows 전용, macOS 와 Android 는 동작 없는 스텁)
class FontEx
  # 폰트 이름, 크기, 텍스처 크기로 생성 (Lua 는 인자가 부족하면 0 반환)
  def initialize: (String face, Integer size, Integer width, Integer height) -> void

  # 갱신 (현재 동작 없음)
  def update: (Numeric elapsed) -> FontEx

  # 화면에 그리기
  def draw: () -> FontEx

  # 표시할 텍스트 설정
  def text=: (String text) -> void

  # 위치 설정
  def set_position: (Integer x, Integer y) -> FontEx

  # 텍스트 색 설정
  def set_text_color: (Integer r, Integer g, Integer b) -> FontEx

  # 불투명도 설정
  def opacity=: (Integer opacity) -> void

  # 회전 각도(도) 설정
  def angle=: (Numeric degrees) -> void

  # 텍스트 너비 (px)
  def text_width: (String text) -> Integer

  # 폰트 해제
  def dispose: () -> void

  # 이미 해제했으면 true (해제 후 사용하면 RuntimeError)
  def disposed?: () -> bool
end
