        { "lua": "draw_point", "ruby": "draw_point", "params": [{ "name": "x", "type": "number" }, { "name": "y", "type": "number" }], "returns": "nil", "doc": "점 1개 그리기 (색은 Lua 는 draw_set_color, Ruby 는 set_color 로 설정, Lua 는 0 반환)" }
