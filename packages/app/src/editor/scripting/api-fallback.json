        { "lua": "IsMouseUp", "ruby": "mouse_up?", "params": [{ "name": "button", "type": "button" }], "returns": "boolean", "doc": "이번 틱에 마우스 버튼을 떼었으면 true", "rubyKind": "predicate" },
        { "lua": "IsMousePress", "ruby": "mouse_press?", "params": [{ "name": "button", "type": "button" }], "returns": "boolean", "doc": "마우스 버튼이 눌린 상태면 true", "rubyKind": "predicate" },
