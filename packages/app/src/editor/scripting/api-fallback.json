      "functions": [
        { "lua": "WindowWidth", "ruby": "width", "params": [], "returns": "number", "doc": "논리 해상도 너비 (px, 렌더 배율로 나눈 값)", "rubyKind": "getter" },
        { "lua": "WindowHeight", "ruby": "height", "params": [], "returns": "number", "doc": "논리 해상도 높이 (px, 렌더 배율로 나눈 값)", "rubyKind": "getter" },
