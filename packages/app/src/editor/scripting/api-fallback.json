        { "lua": null, "ruby": "release?", "params": [{ "name": "key", "type": "key" }], "returns": "boolean", "doc": "key_up? 의 별칭 (RGSS 이름). 이번 틱에 떼었으면 true", "rubyKind": "predicate", "alias": true },
