{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "InitialEditor 프런트(packages/app)가 쓰는 권한. 파일과 프로세스는 전부 src-tauri 의 명령을 거치므로 fs, shell 플러그인은 열지 않는다. opener 는 바깥 링크를 여는 openUrl 하나만, 주소는 저자의 GitHub 와 웹판으로 좁힌다.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:menu:default",
    "core:window:default",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "core:window:allow-theme",
    "core:window:allow-set-size",
    "core:window:allow-set-min-size",
    "core:window:allow-set-position",
    "core:window:allow-set-focus",
    "core:window:allow-set-fullscreen",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-center",
    "core:window:allow-start-dragging",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:event:allow-emit-to",
    "core:app:default",
    "core:path:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "window-state:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/biud436/*" }, { "url": "https://initial-editor.biud436.com/*" }]
    }
  ]
}
