{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InitialEditor",
  "version": "2.0.0",
  "identifier": "com.biud436.initialeditor",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../packages/app/dist",
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "InitialEditor",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
